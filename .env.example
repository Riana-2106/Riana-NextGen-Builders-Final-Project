# Connection string ke database PostgreSQL.
# Untuk deploy ke Vercel, gunakan connection string dari Vercel Postgres/Neon/Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/catering_dev"

# Password untuk login dashboard admin. Ganti dengan password yang kuat.
ADMIN_PASSWORD="ganti-password-ini"

# Token acak (rahasia) untuk sesi admin. Generate baru dengan:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SESSION_TOKEN="ganti-dengan-token-acak"
